---
---

<header class="fixed inset-x-0 top-0 z-30">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3">
      <svg
        class="h-6 w-auto text-foreground"
        viewBox="0 0 122 135"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M 105.500 12.572 C 101.650 16.136, 91.750 24.155, 83.500 30.392 C 59.486 48.547, 39.599 67.920, 31.913 80.644 C 26.345 89.862, 21.189 100.776, 18.516 109 C 15.715 117.620, 14.266 119.849, 6.897 126.878 C 3.104 130.495, 0 133.803, 0 134.228 C 0 136.216, 4.186 134.531, 11.500 129.600 C 15.900 126.633, 24.900 121.461, 31.500 118.107 C 38.100 114.753, 45.814 110.094, 48.641 107.754 C 69.115 90.814, 80.854 78.771, 89.339 66 C 91.349 62.975, 93.339 60.050, 93.763 59.500 C 95.049 57.828, 101.915 44.930, 105.474 37.500 C 110.421 27.174, 115.681 5.896, 113.250 6.046 C 112.838 6.072, 109.350 9.008, 105.500 12.572"
          fill="currentColor"
          fill-rule="evenodd"
        ></path>
      </svg>
      <span class="font-sans text-base font-semibold tracking-tight text-foreground">Plasma Studios</span>
    </a>

    <nav class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema"
        aria-pressed="false"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors duration-200 hover:border-accent hover:text-accent active:scale-[0.98]"
      >
        <svg id="icon-sun" class="h-[18px] w-[18px]" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path
            d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM48,128a8,8,0,0,0-8-8H16a8,8,0,0,0,0,16H40A8,8,0,0,0,48,128Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V216A8,8,0,0,0,128,208Zm112-88H216a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"
          ></path>
        </svg>
        <svg id="icon-moon" class="hidden h-[18px] w-[18px]" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path
            d="M233.54,142.23a8,8,0,0,0-8-2,88.08,88.08,0,0,1-109.8-109.8,8,8,0,0,0-10-10,104.84,104.84,0,0,0-52.91,37A104,104,0,0,0,136,224a103.09,103.09,0,0,0,62.52-20.88,104.84,104.84,0,0,0,37-52.91A8,8,0,0,0,233.54,142.23ZM188.9,190.34A88,88,0,0,1,65.66,67.11a89,89,0,0,1,31.4-26A106,106,0,0,0,96,56,104.11,104.11,0,0,0,200,160a106,106,0,0,0,14.92-1.06A89,89,0,0,1,188.9,190.34Z"
          ></path>
        </svg>
      </button>

      <a
        id="contact-link"
        href="mailto:hola@plasmastudios.com"
        class="inline-flex h-10 items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-white shadow-sm transition-transform duration-200 hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 active:scale-[0.97]"
      >
        Contáctanos
      </a>
    </nav>
  </div>
</header>

<script>
  import { gsap } from 'gsap';

  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const sun = document.getElementById('icon-sun');
  const moon = document.getElementById('icon-moon');

  function syncIcon() {
    const isDark = root.getAttribute('data-theme') === 'dark';
    sun?.classList.toggle('hidden', isDark);
    moon?.classList.toggle('hidden', !isDark);
    toggle?.setAttribute('aria-pressed', String(isDark));
  }
  syncIcon();

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncIcon();
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const contactLink = document.getElementById('contact-link');

  if (contactLink && !reduceMotion) {
    const xTo = gsap.quickTo(contactLink, 'x', { duration: 0.4, ease: 'power3.out' });
    const yTo = gsap.quickTo(contactLink, 'y', { duration: 0.4, ease: 'power3.out' });

    contactLink.addEventListener('pointermove', (e) => {
      const rect = contactLink.getBoundingClientRect();
      xTo((e.clientX - (rect.left + rect.width / 2)) * 0.3);
      yTo((e.clientY - (rect.top + rect.height / 2)) * 0.3);
    });

    contactLink.addEventListener('pointerleave', () => {
      xTo(0);
      yTo(0);
    });
  }
</script>
