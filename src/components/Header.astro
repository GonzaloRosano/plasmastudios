---
interface Props {
  withIntro?: boolean;
}

const { withIntro = false } = Astro.props;
const NBSP = String.fromCharCode(160);
const brandChars = 'Plasma Studios'.split('').map((ch) => (ch === String.fromCharCode(32) ? NBSP : ch));

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/trabajo', label: 'Trabajo' },
];

const contact = { href: '/contacto', label: 'Contacto' };
const isContactActive = current === normalize(contact.href);

const linkClass = (href: string) => {
  const active = current === normalize(href);
  return [
    'rounded-sm px-1 py-2 text-sm font-medium text-foreground underline-offset-[6px] transition-colors duration-200 hover:underline',
    active ? 'underline' : '',
  ].join(' ');
};

const contactClass = [
  'inline-flex h-10 items-center justify-center rounded-md border px-5 text-sm font-medium transition-colors duration-200',
  isContactActive
    ? 'border-transparent bg-foreground text-background'
    : 'border-foreground bg-transparent text-foreground hover:bg-foreground hover:text-background',
].join(' ');
---

<header class="fixed inset-x-0 top-0 z-30 bg-background">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <svg
        id="header-logo"
        class="h-6 w-auto shrink-0 text-foreground"
        viewBox="0 0 122 135"
        fill="none"
        aria-hidden="true"
        style={withIntro ? 'opacity:0' : undefined}
      >
        <path
          d="M 105.500 12.572 C 101.650 16.136, 91.750 24.155, 83.500 30.392 C 59.486 48.547, 39.599 67.920, 31.913 80.644 C 26.345 89.862, 21.189 100.776, 18.516 109 C 15.715 117.620, 14.266 119.849, 6.897 126.878 C 3.104 130.495, 0 133.803, 0 134.228 C 0 136.216, 4.186 134.531, 11.500 129.600 C 15.900 126.633, 24.900 121.461, 31.500 118.107 C 38.100 114.753, 45.814 110.094, 48.641 107.754 C 69.115 90.814, 80.854 78.771, 89.339 66 C 91.349 62.975, 93.339 60.050, 93.763 59.500 C 95.049 57.828, 101.915 44.930, 105.474 37.500 C 110.421 27.174, 115.681 5.896, 113.250 6.046 C 112.838 6.072, 109.350 9.008, 105.500 12.572"
          fill="currentColor"
          fill-rule="evenodd"
        ></path>
      </svg>
      <span id="brand-text" class="whitespace-nowrap font-sans text-base font-semibold tracking-tight text-foreground">
        {brandChars.map((ch) => (
          <span class="brand-char inline-block" style={withIntro ? 'opacity:0' : undefined} set:text={ch} />
        ))}
      </span>
    </a>

    <nav class="hidden items-center gap-1 sm:gap-2 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class={`header-reveal ${linkClass(link.href)}`}
          style={withIntro ? 'opacity:0; transform: translateX(-8px)' : undefined}
          aria-current={current === normalize(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <span
        class="header-reveal mx-3 h-4 w-px bg-border"
        style={withIntro ? 'opacity:0' : undefined}
        aria-hidden="true"
      ></span>
      <a
        href={contact.href}
        class={`header-reveal ${contactClass}`}
        style={withIntro ? 'opacity:0; transform: translateX(-8px)' : undefined}
        aria-current={isContactActive ? 'page' : undefined}
      >
        {contact.label}
      </a>
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-border text-foreground transition-colors duration-200 hover:border-accent hover:text-accent md:hidden"
    >
      <svg id="icon-menu-open" class="h-5 w-5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"
        ></path>
      </svg>
      <svg id="icon-menu-close" class="hidden h-5 w-5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
        ></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border bg-background px-6 py-4 md:hidden">
    <nav class="flex flex-col gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          class={`rounded-sm px-2 py-3 text-base font-medium text-foreground ${current === normalize(link.href) ? 'underline underline-offset-[6px]' : ''}`}
          aria-current={current === normalize(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href={contact.href}
        class={`mt-2 inline-flex h-11 items-center justify-center rounded-md border px-5 text-base font-medium ${isContactActive ? 'border-transparent bg-foreground text-background' : 'border-foreground bg-transparent text-foreground'}`}
        aria-current={isContactActive ? 'page' : undefined}
      >
        {contact.label}
      </a>
    </nav>
  </div>

  {withIntro && (
    <noscript>
      <style>
        #header-logo, .brand-char, .header-reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  )}
</header>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
