---
import LogoMark from './LogoMark.astro';

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/trabajo', label: 'Trabajo' },
];

const contact = { href: '/contacto', label: 'Contacto' };
const isContactActive = current === normalize(contact.href);

const linkClass = (href: string) => {
  const active = current === normalize(href);
  return [
    'rounded-full px-3 py-1.5 text-sm font-medium underline-offset-4 transition-colors duration-200',
    active ? 'text-foreground underline' : 'text-foreground hover:bg-border/40',
  ].join(' ');
};
---

<header id="site-header" class="fixed inset-x-0 top-4 z-30 px-4 transition-transform duration-300">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-1 rounded-full border border-border bg-background/80 py-1.5 pl-4 pr-1.5 shadow-lg backdrop-blur-md">
    <a href="/" class="font-display mr-5 flex shrink-0 items-center gap-2 whitespace-nowrap text-sm font-semibold tracking-tight text-foreground">
      <LogoMark class="h-6 w-auto shrink-0 text-foreground" ariaHidden />
      Plasma Studios
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <a href={link.href} class={linkClass(link.href)} aria-current={current === normalize(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a
        href={contact.href}
        class={`ml-1 inline-flex h-8 items-center justify-center rounded-full px-4 text-sm font-medium transition-colors duration-200 ${
          isContactActive ? 'bg-accent text-white' : 'bg-foreground text-background hover:opacity-90'
        }`}
        aria-current={isContactActive ? 'page' : undefined}
      >
        {contact.label}
      </a>
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-foreground transition-colors duration-200 hover:bg-border/40 md:hidden"
    >
      <svg id="icon-menu-open" class="h-5 w-5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"
        ></path>
      </svg>
      <svg id="icon-menu-close" class="hidden h-5 w-5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
        ></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mx-auto mt-2 hidden max-w-sm rounded-2xl border border-border bg-background/95 px-4 py-3 shadow-lg backdrop-blur-md md:hidden">
    <nav class="flex flex-col gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          class={`rounded-full px-3 py-2.5 text-base font-medium underline-offset-4 ${current === normalize(link.href) ? 'text-foreground underline' : 'text-foreground'}`}
          aria-current={current === normalize(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href={contact.href}
        class={`mt-1 inline-flex h-11 items-center justify-center rounded-full px-5 text-base font-medium ${isContactActive ? 'bg-accent text-white' : 'bg-foreground text-background'}`}
        aria-current={isContactActive ? 'page' : undefined}
      >
        {contact.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  const siteHeader = document.getElementById('site-header');
  let lastY = window.scrollY;
  function onHeaderScroll() {
    const y = window.scrollY;
    const hidden = y > lastY && y > 80;
    siteHeader?.classList.toggle('-translate-y-24', hidden);
    lastY = y;
  }
  window.addEventListener('scroll', onHeaderScroll, { passive: true });
</script>
