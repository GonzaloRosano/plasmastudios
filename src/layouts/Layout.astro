---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SmoothScroll from '../components/SmoothScroll.astro';

interface Props {
  title: string;
  description: string;
  lockScrollUntilReady?: boolean;
}

const { title, description, lockScrollUntilReady = false } = Astro.props;
---

<!doctype html>
<html lang="es" style={lockScrollUntilReady ? 'overflow:hidden' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://mc-heads.net" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color-meta" content="#0a0a0b" />
    {lockScrollUntilReady && (
      <noscript>
        <style>html { overflow: auto !important; }</style>
      </noscript>
    )}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0a0a0b' : '#fafafa');
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-[100dvh] bg-background text-foreground antialiased selection:bg-accent/20">
    <slot />
    <ThemeToggle />
    <SmoothScroll />
  </body>
</html>
