---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import LogoMark from '../../components/LogoMark.astro';
import ThreeLogo from '../../components/ThreeLogo.astro';
import team from '../../data/team.json';
import { LOCALES, t, localePath, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const strings = t(lang);

type Member = { id: string; name: string; discordAvatar: string };
const members = team as Member[];

const teamPreview = members.slice(0, 9);
const teamCount = members.length;
---

<Layout title={strings.home.title} description={strings.home.description} lang={lang}>
  <Header />

  <main>
    <section class="relative min-h-[100dvh] overflow-hidden px-6 pt-24">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute inset-0 opacity-[0.05]"
          style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 26px 26px; color: var(--foreground); mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, black, transparent);"
        ></div>
      </div>

      <div class="relative mx-auto flex min-h-[calc(100dvh-6rem)] max-w-5xl flex-col items-center justify-center gap-6 text-center lg:max-w-6xl lg:flex-row lg:gap-16 lg:text-left">
        <ThreeLogo class="h-36 w-36 shrink-0 sm:h-44 sm:w-44 lg:h-[26rem] lg:w-[26rem]" />

        <div class="flex flex-col items-center lg:items-start">
          <h1 class="vt-text font-display mt-2 min-h-[2lh] max-w-2xl text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl md:text-6xl lg:mt-0">
            {strings.home.heroTitle}
          </h1>
          <p class="vt-text mt-4 max-w-[46ch] text-base text-muted">
            {strings.home.heroSubtitle}
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a
              href={localePath(lang, 'nosotros')}
              class="vt-text inline-flex h-11 items-center justify-center rounded-md border border-foreground px-6 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background"
            >
              {strings.home.meetTeam}
            </a>
            <span class="vt-text inline-flex h-11 items-center justify-center rounded-md px-6 text-sm font-medium text-muted">
              {strings.home.comingSoon}
            </span>
          </div>
          <p class="vt-text mt-10 text-xs tracking-[0.2em] text-muted uppercase">
            {strings.home.peopleCount(teamCount)}
          </p>
        </div>
      </div>

      <a
        href="#equipo"
        aria-label={strings.home.meetTeam}
        class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 text-muted transition-colors duration-200 hover:text-foreground"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v14M6 13l6 6 6-6" />
        </svg>
      </a>
    </section>

    <section id="equipo" class="flex min-h-[100dvh] flex-col items-center justify-center border-t border-border px-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 text-center">
        <a href={localePath(lang, 'nosotros')} class="flex -space-x-3 transition-transform duration-300 hover:-translate-y-1">
          {teamPreview.map((member) => (
            <img
              src={member.discordAvatar}
              alt={member.name}
              width="56"
              height="56"
              class="h-12 w-12 rounded-full border-2 border-background object-cover sm:h-14 sm:w-14"
            />
          ))}
        </a>

        <div class="max-w-xl">
          <h2 class="vt-text font-display min-h-[2lh] text-2xl font-semibold tracking-tight text-balance text-foreground sm:text-3xl">
            {strings.home.teamHeading(teamCount)}
          </h2>
          <p class="vt-text mt-3 text-base text-muted">
            {strings.home.teamSubheading}
          </p>
        </div>

        <a
          href={localePath(lang, 'nosotros')}
          class="vt-text inline-flex h-11 items-center justify-center rounded-md border border-foreground px-6 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background"
        >
          {strings.home.meetTeam}
        </a>
      </div>
    </section>

    <section class="border-t border-border px-6 py-20">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 sm:flex-row">
        <div class="flex items-center gap-3">
          <LogoMark class="h-5 w-auto text-muted" ariaHidden />
          <span class="text-sm text-muted">Plasma Studios</span>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href={localePath(lang, 'nosotros')} class="text-muted transition-colors duration-200 hover:text-foreground">{strings.nav.about}</a>
          <a href={localePath(lang, 'trabajo')} class="text-muted transition-colors duration-200 hover:text-foreground">{strings.nav.work}</a>
          <span class="text-muted">{strings.home.comingSoon}</span>
        </nav>
      </div>
    </section>
  </main>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .scroll-cue {
        animation: scroll-cue-bounce 2s ease-in-out infinite;
      }
    }

    @keyframes scroll-cue-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(4px); }
    }
  </style>
</Layout>
