---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import team from '../../../data/team.json';
import { LOCALES, t, localePath, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const strings = t(lang);
---

<Layout title={`${strings.nosotros.title} — Plasma Studios`} description={strings.nosotros.description} lang={lang}>
  <Header />

  <main class="flex min-h-[100dvh] flex-col items-center px-6 pb-24 pt-32">
    <div class="max-w-xl text-center">
      <h1 class="vt-text font-display text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl">{strings.nosotros.title}</h1>
      <p class="vt-text mt-4 text-lg text-muted">{strings.nosotros.subtitle}</p>
    </div>

    {team.length === 0 ? (
      <p class="vt-text mt-16 text-sm text-muted">{strings.nosotros.empty}</p>
    ) : (
      <div class="mt-16 grid w-full max-w-6xl grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
        {team.map((member: { id: string; name: string; role: string; discordAvatar: string; ceo?: boolean }, i: number) => (
          <a
            href={localePath(lang, `nosotros/${member.id}`)}
            class="team-card group flex flex-col items-center gap-3 rounded-lg p-4 text-center transition-colors duration-200 hover:bg-border/20 sm:p-6"
            style={`animation-delay: ${Math.min(i * 40, 400)}ms`}
          >
            <div class="relative">
              <img
                src={member.discordAvatar}
                alt={member.name}
                width="96"
                height="96"
                class="h-20 w-20 rounded-full border border-border object-cover transition-all duration-200 group-hover:border-accent group-hover:shadow-[0_0_0_4px] group-hover:shadow-accent/10 sm:h-24 sm:w-24"
              />
              {member.ceo && (
                <span class="vt-text absolute -bottom-1 left-1/2 -translate-x-1/2 rounded-full border border-background bg-accent px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white">
                  CEO
                </span>
              )}
            </div>
            <div>
              <p class="vt-text text-sm font-semibold text-foreground sm:text-base">{member.name}</p>
              {member.role && <p class="vt-text text-xs text-muted sm:text-sm">{member.role}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </main>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .team-card {
        animation: team-card-in 0.4s ease-out both;
      }
    }

    @keyframes team-card-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
