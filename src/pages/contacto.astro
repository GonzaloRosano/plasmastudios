---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Contacto — Plasma Studios" description="Contactá a Plasma Studios.">
  <Header />

  <main class="flex min-h-[100dvh] items-center justify-center px-6 pt-24">
    <div class="max-w-xl text-center">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contacto</h1>
      <p class="mt-4 text-base text-muted">Escribinos y te respondemos a la brevedad.</p>
      <a
        href="mailto:hola@plasmastudios.com"
        class="mt-8 inline-flex h-11 items-center justify-center rounded-md border border-foreground px-6 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background"
      >
        hola@plasmastudios.com
      </a>
    </div>
  </main>
</Layout>
