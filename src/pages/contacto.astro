---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Contacto — Plasma Studios" description="Contactá a Plasma Studios.">
  <Header />

  <main class="flex min-h-[100dvh] flex-col items-center px-6 pb-24 pt-32">
    <div class="max-w-xl text-center">
      <h1 class="text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl">Contacto</h1>
      <p class="mt-4 text-lg text-muted">Escribinos y te respondemos a la brevedad.</p>
      <span class="mt-8 inline-flex h-11 items-center justify-center rounded-md border border-border px-6 text-sm font-medium text-muted">
        Próximamente
      </span>
    </div>
  </main>
</Layout>
