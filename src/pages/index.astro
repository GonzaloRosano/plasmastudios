---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LogoMark from '../components/LogoMark.astro';
---

<Layout title="Plasma Studios" description="Plasma Studios." lockScrollUntilReady>
  <Header withIntro />

  <main class="relative min-h-[100dvh] px-6 pt-24">
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
      <LogoMark
        id="logo-hero"
        class="h-40 w-auto text-foreground sm:h-48 md:h-56"
        style="opacity:0; transform: scale(0.92) translateY(12px)"
        ariaLabel="Plasma Studios"
      />
    </div>

    <div
      id="hero-content"
      class="mx-auto flex min-h-[calc(100dvh-6rem)] max-w-3xl flex-col items-center justify-center text-center"
      style="opacity:0; transform: translateY(12px)"
    >
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">
        Diseño y desarrollo para juegos y comunidades.
      </h1>
      <p class="mt-4 max-w-[46ch] text-base text-muted">
        Plasma Studios combina diseño, desarrollo y comunidad para crear experiencias que la gente vuelve a usar.
      </p>
      <a
        href="/nosotros"
        class="mt-8 inline-flex h-11 items-center justify-center rounded-md border border-foreground px-6 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-foreground hover:text-background"
      >
        Conocé al equipo
      </a>
    </div>
  </main>

  <noscript>
    <style>
      #logo-hero, #hero-content { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <script>
    import { gsap } from 'gsap';
    import { Flip } from 'gsap/Flip';

    gsap.registerPlugin(Flip);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heroLogo = document.getElementById('logo-hero');
    const headerLogo = document.getElementById('header-logo');
    const heroContent = document.getElementById('hero-content');
    const brandChars = document.querySelectorAll('.brand-char');
    const navTargets = document.querySelectorAll('.header-reveal');

    const root = document.documentElement;

    // Layout.astro bakes overflow:hidden on <html> for this page (lockScrollUntilReady)
    // so the intro never has a race window where a scrollbar can flash before JS runs.
    function releaseScrollLock() {
      let stableFrames = 0;
      function check() {
        const settled = root.scrollHeight <= window.innerHeight;
        stableFrames = settled ? stableFrames + 1 : 0;
        if (stableFrames >= 3) {
          root.style.overflow = '';
          return;
        }
        requestAnimationFrame(check);
      }
      requestAnimationFrame(check);
    }

    if (heroLogo && headerLogo) {
      if (reduceMotion) {
        heroLogo.style.display = 'none';
        gsap.set(headerLogo, { opacity: 1 });
        gsap.set(brandChars, { opacity: 1, y: 0 });
        gsap.set(navTargets, { opacity: 1, x: 0 });
        if (heroContent) gsap.set(heroContent, { opacity: 1, y: 0 });
        root.style.overflow = '';
      } else {
        // baked in the markup already: heroLogo/heroContent hidden/offset, headerLogo/brandChars/nav hidden via style attrs
        gsap.set(brandChars, { y: 4 });

        const tl = gsap.timeline();

        tl.to(heroLogo, { opacity: 1, scale: 1, y: 0, duration: 0.7, ease: 'expo.out', delay: 0.05 })
          .to({}, { duration: 0.25 }) // hold
          .add(() => {
            Flip.fit(heroLogo, headerLogo, {
              duration: 0.6,
              ease: 'power3.inOut',
              scale: true,
              absolute: true,
              onComplete: () => {
                gsap.set(heroLogo, { opacity: 0, display: 'none' });
                gsap.set(headerLogo, { opacity: 1 });
                gsap.to(brandChars, {
                  opacity: 1,
                  y: 0,
                  duration: 0.25,
                  stagger: 0.03,
                  ease: 'power2.out',
                });
                gsap.to(navTargets, {
                  opacity: 1,
                  x: 0,
                  duration: 0.35,
                  stagger: { each: 0.07, from: 'end' },
                  ease: 'power2.out',
                });
                if (heroContent) {
                  gsap.to(heroContent, {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    ease: 'power3.out',
                  });
                }
                releaseScrollLock();
              },
            });
          });
      }
    } else {
      root.style.overflow = '';
    }
  </script>
</Layout>
