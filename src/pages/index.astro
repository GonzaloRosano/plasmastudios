---
import { DEFAULT_LOCALE, LOCALES, localePath } from '../i18n/ui';
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${localePath(DEFAULT_LOCALE, '')}`} />
    <link rel="canonical" href={localePath(DEFAULT_LOCALE, '')} />
    <title>Plasma Studios</title>
    <script is:inline define:vars={{ locales: LOCALES, defaultLocale: DEFAULT_LOCALE }}>
      try {
        var browser = navigator.language ? navigator.language.toLowerCase().slice(0, 2) : defaultLocale;
        var lang = locales.includes(browser) ? browser : defaultLocale;
        window.location.replace('/' + lang + '/');
      } catch (_) {
        window.location.replace('/' + defaultLocale + '/');
      }
    </script>
  </head>
  <body></body>
</html>
